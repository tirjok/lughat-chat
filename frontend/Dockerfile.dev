# Development Dockerfile — Nuxt dev server with hot reload
# Node 24+ required: ESLint 10.x uses Object.groupBy (Node 21+ feature).
FROM node:24-alpine

# Install pnpm
RUN corepack enable && corepack prepare pnpm@11.13.1 --activate

WORKDIR /app

# Copy package files first (for layer caching)
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

# Install dependencies (dev deps included).
# The lockfile may contain host-platform native bindings (darwin-arm64).
# Running without --frozen-lockfile lets pnpm re-resolve platform-specific
# optional dependencies for the target (linux-arm64-musl) platform.
RUN rm -rf node_modules && pnpm install --frozen-lockfile || pnpm install

# Copy source code
COPY . .

# Expose dev server port
EXPOSE 3000

# When running in Docker, proxy frontend dev server to backend-dev container
ENV NODE_ENV=docker
ENV HOST=0.0.0.0

# Run dev server with hot reload
# Clean .nuxt on startup to avoid stale socket paths from volume mounts
ENTRYPOINT ["sh", "-c"]
CMD ["pnpm dev"]
