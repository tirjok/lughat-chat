{
  "name": "frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "find . \\( -name 'node_modules' -o -name '.data' -o -name '.nuxt' -o -name '.pnpm-store' -o -name '.dist' -o -name '.output' \\) -type d -prune -exec rm -rf '{}' +"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.2.8",
    "@fontsource/cairo": "^5.2.7",
    "@fontsource/noto-sans-arabic": "^5.2.10",
    "@fontsource/plus-jakarta-sans": "^5.2.8",
    "@iconify-json/lucide": "^1.2.106",
    "@iconify-json/simple-icons": "^1.2.81",
    "@nuxt/image": "2.0.0",
    "@unocss/nuxt": "66.6.8",
    "@vueuse/core": "^14.3.0",
    "nuxt": "^4.4.5"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.15.2",
    "@nuxt/test-utils": "^4.0.3",
    "@unocss/reset": "^66.7.2",
    "@vue/test-utils": "^2.4.10",
    "eslint": "^10.3.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "unocss": "^66.7.2",
    "vitest": "^4.1.7",
    "vue": "^3.5.13",
    "vue-tsc": "^3.2.8"
  },
  "packageManager": "pnpm@10.33.4"
}
